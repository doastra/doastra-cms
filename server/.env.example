# Server
PORT=4000
PUBLIC_URL=http://localhost:4000
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=*

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/doastra_cms

# First super admin (created by `npm run seed`)
ADMIN_EMAIL=admin@doastra.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Super Admin

# Media storage: "local" (saved in ./uploads) or "s3"
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=ap-south-1
# Optional CloudFront / CDN base URL for S3 files, e.g. https://cdn.doastra.com
S3_PUBLIC_URL=

# Public API cache in seconds (0 = off)
PUBLIC_CACHE_TTL=60
